 readchar(io::IO) = eof(io) ? EOF_CHAR : read(io, Char)
 
+# An immutable lookup table: sorted keys, binary search. Unlike a `Dict` it is isbits, so a lookup
+# compiles to code and constant data and needs no heap object at run time (`--trim`med or
+# statically compiled lexers).
+struct ConstMap{N,K,V}
+    keys::NTuple{N,K}
+    vals::NTuple{N,V}
+end
+function ConstMap(pairs)
+    ps = sort!(collect(pairs); by=first)
+    allunique(first.(ps)) || error("duplicate keys")
+    ConstMap(Tuple(first.(ps)), Tuple(last.(ps)))
+end
+Base.keys(m::ConstMap) = m.keys
+Base.length(::ConstMap{N}) where {N} = N
+function Base.get(m::ConstMap{N}, k, default) where {N}
+    lo, hi = 1, N
+    while lo <= hi
+        mid = (lo + hi) >>> 1
+        km = @inbounds m.keys[mid]
+        if km == k
+            return @inbounds m.vals[mid]
+        elseif km < k
+            lo = mid + 1
+        else
+            hi = mid - 1
+        end
+    end
+    return default
+end
